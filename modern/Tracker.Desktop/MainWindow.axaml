<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Tracker.Desktop" x:Class="Tracker.Desktop.MainWindow" x:CompileBindings="True"
 Title="Twitch Category Tracker" Width="760" Height="520" MinWidth="620" MinHeight="400" WindowStartupLocation="CenterScreen" Icon="/Assets/tracker.ico">
 <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16,12,16,10">
  <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,12">
   <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center"><TextBlock Text="◉" Foreground="#B69AF4" FontSize="20"/><TextBlock Text="Twitch Category Tracker" FontSize="16" FontWeight="SemiBold"/></StackPanel>
   <Button Grid.Column="1" Name="RefreshButton" Content="↻" Classes="tool" Click="Refresh" ToolTip.Tip="Обновить сейчас"/>
   <Button Grid.Column="2" Name="PauseButton" Content="Ⅱ" Classes="tool" Click="Pause" ToolTip.Tip="Пауза / продолжить"/>
   <Button Grid.Column="3" Content="⚙" Classes="tool" Click="ToggleSettings" ToolTip.Tip="Настройки"/>
  </Grid>
  <Grid Grid.Row="1" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
   <TextBox Name="ChannelInput" PlaceholderText="Ник стримера или ссылка twitch.tv/…" KeyDown="OnInputKey" Margin="0,0,8,0"/>
   <Button Name="AddButton" Grid.Column="1" Content="＋ Добавить" Classes="primary" Click="AddChannel"/>
   <Border Name="ErrorPanel" Grid.Row="1" Grid.ColumnSpan="2" IsVisible="False" Background="#382C25" CornerRadius="6" Padding="10,7" Margin="0,8,0,0"><TextBlock Name="ErrorText" Foreground="#F2C89A" TextWrapping="Wrap"/></Border>
  </Grid>
  <Grid Grid.Row="2">
   <Border Background="#191C25" CornerRadius="7" BorderBrush="#2A2F3D" BorderThickness="1">
    <Grid RowDefinitions="Auto,*">
     <Border BorderBrush="#2A2F3D" BorderThickness="0,0,0,1" Padding="12,8"><Grid ColumnDefinitions="145,*,80,42,52"><TextBlock Text="Стример" Classes="muted" FontSize="11"/><TextBlock Grid.Column="1" Text="Категория" Classes="muted" FontSize="11"/><TextBlock Grid.Column="2" Text="Статус" Classes="muted" FontSize="11"/><TextBlock Grid.Column="3" Text="Увед." Classes="muted" FontSize="11" HorizontalAlignment="Center" ToolTip.Tip="Уведомления для отдельного стримера"/></Grid></Border>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel><TextBlock Name="EmptyState" Text="Добавь стримера — отслеживание начнётся сразу." Classes="muted" HorizontalAlignment="Center" Margin="12,45"/>
       <ItemsControl Name="ChannelList"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:ChannelRow">
        <Border Padding="12,10" BorderBrush="#282C39" BorderThickness="0,0,0,1">
         <Grid ColumnDefinitions="145,*,80,42,52" MinHeight="32">
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
          <TextBlock Grid.Column="1" Text="{Binding Category}" Foreground="#C5B0F3" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" ToolTip.Tip="{Binding Detail}"/>
          <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{Binding StatusColor}" FontSize="11" VerticalAlignment="Center" ToolTip.Tip="{Binding Detail}"/>
          <CheckBox Grid.Column="3" IsChecked="{Binding Notifications, Mode=OneWay}" Tag="{Binding Login}" Click="ToggleChannelNotifications" MinWidth="0" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="Включить или выключить уведомления этого стримера"/>
          <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="↗" Tag="{Binding Login}" Classes="tool" Padding="6,2" Click="OpenChannel" ToolTip.Tip="Открыть канал"/><Button Content="×" Tag="{Binding Login}" Classes="tool" Padding="6,2" Click="RemoveChannel" ToolTip.Tip="Убрать из списка"/></StackPanel>
         </Grid>
        </Border>
       </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
     </ScrollViewer>
    </Grid>
   </Border>
  </Grid>
   <Border Grid.Row="2" Grid.RowSpan="2" ZIndex="20" Name="SettingsPanel" IsVisible="False" HorizontalAlignment="Right" VerticalAlignment="Top" Width="340" MaxHeight="370" Padding="18" CornerRadius="8" Background="#242835" BorderBrush="#454C63" BorderThickness="1" BoxShadow="0 4 20 0 #60000000">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="12">
     <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Настройки" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/><Button Grid.Column="1" Content="×" Classes="tool" Click="ToggleSettings"/></Grid>
     <Grid ColumnDefinitions="*,110"><TextBlock Text="Проверять каждые, сек." VerticalAlignment="Center"/><NumericUpDown Name="IntervalInput" Grid.Column="1" Minimum="30" Maximum="3600" Increment="15" FormatString="0" Value="30"/></Grid>
     <CheckBox Name="NotificationsInput" Content="Уведомлять о смене категории" IsChecked="True"/>
     <CheckBox Name="OnlineInput" Content="Также о начале и конце эфира" IsChecked="True"/>
     <CheckBox Name="TrayInput" Content="При закрытии сворачивать в трей" IsChecked="True"/>
     <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Сохранить" Classes="primary" Click="SaveSettings"/><Button Name="TestNotificationButton" Content="Тест уведомления" Classes="tool" Click="TestNotification"/></StackPanel>
     <Button Name="OpenDataButton" Content="Папка данных" Classes="tool" HorizontalAlignment="Left" Click="OpenData"/>
    </StackPanel></ScrollViewer>
   </Border>
  <Border Grid.Row="3" Background="#191C25" CornerRadius="7" BorderBrush="#2A2F3D" BorderThickness="1" Margin="0,10,0,0" Padding="10,4">
   <StackPanel>
    <Grid ColumnDefinitions="*,Auto,Auto,Auto"><TextBlock Name="HistoryCount" Text="Журнал · 0" FontSize="12" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Экспорт" Classes="tool" Click="ExportHistory"/><Button Grid.Column="2" Content="Очистить" Classes="tool" Click="ClearHistory"/><Button Name="HistoryToggle" Grid.Column="3" Content="⌃" Classes="tool" Click="ToggleHistory" ToolTip.Tip="Свернуть / развернуть журнал"/></Grid>
    <ScrollViewer Name="HistoryContent" Height="115"><StackPanel><TextBlock Name="HistoryEmpty" Text="Здесь появятся изменения категорий и события эфира." Classes="muted" FontSize="12" Margin="0,10"/><ItemsControl Name="HistoryList"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:HistoryRow"><Grid ColumnDefinitions="64,115,*" Margin="0,5"><TextBlock Text="{Binding Time}" Classes="muted" FontSize="11"/><TextBlock Grid.Column="1" Text="{Binding Login}" Foreground="#C5B0F3" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/><TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" FontSize="12"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
   </StackPanel>
  </Border>
 </Grid>
</Window>
